<UserControl x:Class="MixerOnline.Controls.ConsoleFader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="64">
    <Grid HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Readout -->
            <RowDefinition Height="*"/>    <!-- Fader Track -->
        </Grid.RowDefinitions>

        <!-- Minimalist Monochrome Readout (Click to reset to 0.0 dB) -->
        <Border Grid.Row="0" Background="#09090b" BorderBrush="#222226" BorderThickness="1" 
                CornerRadius="4" Padding="8,4" Margin="0,0,0,12" MinWidth="58" HorizontalAlignment="Center"
                Cursor="Hand" MouseLeftButtonDown="OnReadoutClicked" ToolTip="Click to reset to 0.0 dB (100%)">
            <TextBlock x:Name="TxtDb" Text="0.0 dB" FontFamily="Consolas, monospace" FontSize="11" 
                       FontWeight="SemiBold" Foreground="#e4e4e7" HorizontalAlignment="Center"/>
        </Border>

        <!-- Vertical Fader -->
        <Slider x:Name="FaderSlider" Grid.Row="1" Orientation="Vertical"
                Minimum="0" Maximum="1.5" SmallChange="0.01" LargeChange="0.05" Value="1.0"
                HorizontalAlignment="Center" Width="38"
                MouseDoubleClick="OnSliderDoubleClicked"
                ToolTip="Double-click to reset to 0.0 dB"
                Style="{StaticResource ConsoleVerticalSlider}"/>
    </Grid>
</UserControl>
