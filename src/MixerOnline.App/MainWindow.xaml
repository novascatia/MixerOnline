<Window x:Class="MixerOnline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MixerOnline.Controls"
        xmlns:viewmodels="clr-namespace:MixerOnline.ViewModels"
        Title="MixerOnline" 
        Icon="Resources/app.ico"
        Height="760" Width="1020"
        MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.DataContext>
        <viewmodels:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>

    <!-- Matte Carbon Gray-Black Frame -->
    <Border Background="#09090b" BorderBrush="#222226" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header Bar -->
                <RowDefinition Height="*"/>    <!-- 3 Mixer Channels -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER BAR ================= -->
            <Border Grid.Row="0" Background="#0c0c0f" BorderBrush="#1c1c20" BorderThickness="0,0,0,1" 
                    CornerRadius="7,7,0,0" Padding="18,12" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimalist Brand Identity -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Resources/app.png" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="MixerOnline" FontSize="14" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                        <TextBlock Text="Studio" FontSize="13" FontWeight="Normal" Foreground="#52525b" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#1e1e24" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="#a1a1aa"/>
                        </Border>
                    </StackPanel>

                    <!-- Clean Status Pills -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Browser Extension Status -->
                        <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#52525b"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBraveConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#22c55e"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding BraveConnectionText}" Foreground="#a1a1aa" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Virtual Cable Status -->
                        <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="4" Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#52525b"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVirtualCableDetected}" Value="True">
                                                    <Setter Property="Fill" Value="#e4e4e7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding VirtualCableBadgeText}" Foreground="#a1a1aa" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Software Update Available Pill -->
                        <Button Command="{Binding OpenUpdateDialogCommand}"
                                Visibility="{Binding UpdatePillVisibility}"
                                Cursor="Hand"
                                Margin="8,0,0,0"
                                ToolTip="New version available! Click to view release notes and install.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PillBorder" Background="#14233c" BorderBrush="#38bdf8" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                        <TextBlock Text="{Binding UpdateAvailableButtonText}" Foreground="#38bdf8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PillBorder" Property="Background" Value="#1e3a5f"/>
                                            <Setter TargetName="PillBorder" Property="BorderBrush" Value="#7dd3fc"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Actions & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernButton}" Command="{Binding OpenGuideCommand}" Content="Setup Guide" Padding="10,5" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource ModernButton}" Command="{Binding OpenSettingsCommand}" Content="Settings" Padding="10,5" Margin="0,0,12,0"/>

                        <Button Style="{StaticResource WindowControlButton}" Click="OnMinimizeClicked" ToolTip="Minimize">
                            <TextBlock Text="—" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="OnCloseClicked" Margin="2,0,0,0" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 3-CHANNEL MIXER WORKSPACE ================= -->
            <Grid Grid.Row="1" Margin="16,16,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= 01 / BROWSER TAB ================= -->
                <Border Grid.Column="0" Style="{StaticResource ChannelStripStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="01" FontFamily="Consolas" FontSize="11" Foreground="#52525b" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browser Audio" Style="{StaticResource TrackHeaderStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding BrowserSampleRateText}" FontFamily="Consolas" FontSize="10" Foreground="#52525b" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CapturedTabTitle}" Style="{StaticResource TrackSublabelStyle}" 
                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Tab Selector -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      ItemsSource="{Binding BraveTabs}" 
                                      SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                      DisplayMemberPath="Title"/>
                            <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding RefreshTabsCommand}" 
                                    Content="Refresh" Margin="6,0,0,0" Padding="10,0" Height="32" ToolTip="Refresh open browser tabs"/>
                        </Grid>

                        <!-- Fader & Meter -->
                        <Grid Grid.Row="2" Margin="0,4,0,16" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:ConsoleFader Grid.Column="0" Value="{Binding BrowserVolume, Mode=TwoWay}"/>

                            <controls:DualStereoLedMeter Grid.Column="2"
                                                        LevelLeft="{Binding BrowserRms}" PeakLeft="{Binding BrowserPeak}" 
                                                        LevelRight="{Binding BrowserRms}" PeakRight="{Binding BrowserPeak}"/>
                        </Grid>

                        <!-- Mute -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <ToggleButton Style="{StaticResource ConsoleMuteButton}" 
                                          IsChecked="{Binding IsBrowserMuted, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Music Key / Tone Transposer (Karaoke Key Changer) -->
                        <Border Grid.Row="4" Background="#0c0c0e" BorderBrush="#1f1f23" BorderThickness="1" CornerRadius="5" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Key / Tone" FontSize="11" FontWeight="Medium" Foreground="#a1a1aa"/>
                                        <TextBlock Text=" (Transpose)" FontSize="9" Foreground="#52525b" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding BrowserKeySemitonesText}" FontFamily="Consolas" FontSize="11" 
                                               FontWeight="SemiBold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Semitone Transpose Slider (-6 to +6) -->
                                <Slider Style="{StaticResource ConsoleHorizontalSlider}"
                                        Minimum="-6" Maximum="6" SmallChange="1" LargeChange="1"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Value="{Binding BrowserKeySemitones, Mode=TwoWay}"
                                        Margin="0,3,0,5"
                                        ToolTip="Transpose YouTube song key in semitones (flat/sharp) without changing tempo"/>

                                <!-- Quick Semitone Stepper Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Semitones:" FontSize="9" Foreground="#52525b" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource ConsoleMiniBadgeButton}" Content="♭ Down" 
                                            Command="{Binding PitchShiftDownCommand}" ToolTip="Lower key by 1 semitone (-1)"/>
                                    <Button Grid.Column="3" Style="{StaticResource ConsoleMiniBadgeButton}" Content="Reset (0)" 
                                            Command="{Binding ResetPitchCommand}" ToolTip="Reset to original song key"/>
                                    <Button Grid.Column="5" Style="{StaticResource ConsoleMiniBadgeButton}" Content="♯ Up" 
                                            Command="{Binding PitchShiftUpCommand}" ToolTip="Raise key by 1 semitone (+1)"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= 02 / MICROPHONE ================= -->
                <Border Grid.Column="2" Style="{StaticResource ChannelStripStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="02" FontFamily="Consolas" FontSize="11" Foreground="#52525b" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Microphone" Style="{StaticResource TrackHeaderStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="WASAPI" FontFamily="Consolas" FontSize="10" Foreground="#52525b" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedMic.Name, FallbackValue='No Microphone'}" 
                                       Style="{StaticResource TrackSublabelStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Mic Selector -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      ItemsSource="{Binding Microphones}" 
                                      SelectedItem="{Binding SelectedMic, Mode=TwoWay}"
                                      DisplayMemberPath="Name"/>
                            <Button Grid.Column="1" Style="{StaticResource ModernButton}" Command="{Binding RefreshDevicesCommand}" 
                                    Content="Scan" Margin="6,0,0,0" Padding="10,0" Height="32" ToolTip="Rescan audio devices"/>
                        </Grid>

                        <!-- Fader & Meter -->
                        <Grid Grid.Row="2" Margin="0,4,0,16" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:ConsoleFader Grid.Column="0" Value="{Binding MicVolume, Mode=TwoWay}"/>

                            <controls:DualStereoLedMeter Grid.Column="2"
                                                        LevelLeft="{Binding MicRms}" PeakLeft="{Binding MicPeak}" 
                                                        LevelRight="{Binding MicRms}" PeakRight="{Binding MicPeak}"/>
                        </Grid>

                        <!-- Mute -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <ToggleButton Style="{StaticResource ConsoleMuteButton}" 
                                          IsChecked="{Binding IsMicMuted, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Voice FX + Mic Sync Delay -->
                        <StackPanel Grid.Row="4">
                            <!-- Voice FX -->
                            <Border Background="#0c0c0e" BorderBrush="#1f1f23" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Button Command="{Binding ToggleVoiceFxExpandedCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Voice FX" FontSize="11" FontWeight="Medium" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding VoiceEffectStatusText}" FontFamily="Consolas" FontSize="11"
                                                               FontWeight="SemiBold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Width="18" Height="18" Background="#141418" BorderBrush="#27272a" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VoiceFxChevron}" FontFamily="Consolas" FontSize="9"
                                                                   Foreground="#a1a1aa" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Collapsible Voice FX Content -->
                                    <StackPanel Visibility="{Binding VoiceFxContentVisibility}" Margin="0,8,0,0">
                                        <UniformGrid Columns="3" Margin="0,0,0,6">
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Clean"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxOff, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="0"
                                                         ToolTip="Clean unprocessed microphone signal"/>
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Room Isolate"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxRoomIsolate, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="1"
                                                         ToolTip="Tight vocal booth isolation (reduces room rumble and bleed)"/>
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Echo"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxEcho, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="2"
                                                         ToolTip="Warm vocal delay echo"/>
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Telephone"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxTelephone, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="3"
                                                         ToolTip="Band-limited vintage telephone voice filter"/>
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Radio"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxRadio, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="4"
                                                         ToolTip="Broadcast radio presence and warm saturation"/>
                                            <RadioButton Style="{StaticResource ConsoleChipRadioButton}" Content="Hall"
                                                         GroupName="VoiceFxGroup" Margin="2" Padding="4,2"
                                                         IsChecked="{Binding IsVoiceFxHall, Mode=OneWay}"
                                                         Command="{Binding SetVoiceEffectCommand}" CommandParameter="5"
                                                         ToolTip="Spacious concert hall reverb"/>
                                        </UniformGrid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="FX Mix" FontSize="9" Foreground="#52525b" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Grid.Column="1" Style="{StaticResource ConsoleHorizontalSlider}"
                                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding VoiceEffectIntensity, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Blend intensity of the active voice effect (0% to 100%)"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VoiceEffectIntensityText}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#a1a1aa" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Vocal Auto-Tune -->
                            <Border Background="#0c0c0e" BorderBrush="#1f1f23" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Command="{Binding ToggleAutoTuneExpandedCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                                                        <TextBlock Text="Auto-Tune" FontSize="11" FontWeight="Medium" Foreground="#a1a1aa"/>
                                                        <TextBlock Text=" (Pitch Correct)" FontSize="9" Foreground="#52525b" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Border Grid.Column="1" Background="#141418" BorderBrush="#27272a" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AutoTuneNoteDisplay}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{Binding AutoTuneNoteColor}"/>
                                        </Border>
                                        
                                        <ToggleButton Grid.Column="3" Style="{StaticResource ConsoleCueButton}"
                                                      IsChecked="{Binding IsAutoTuneEnabled, Mode=TwoWay}"
                                                      ToolTip="Toggle real-time vocal Auto-Tune pitch correction"/>

                                        <Button Grid.Column="5" Command="{Binding ToggleAutoTuneExpandedCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="Expand / Minimize Auto-Tune controls">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="18" Height="18" Background="#141418" BorderBrush="#27272a" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AutoTuneChevron}" FontFamily="Consolas" FontSize="9"
                                                                   Foreground="#a1a1aa" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Collapsible Auto-Tune Content -->
                                    <StackPanel Visibility="{Binding AutoTuneContentVisibility}" Margin="0,8,0,0">
                                        <!-- Key & Scale Selectors -->
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Root Key:" FontSize="9" Foreground="#52525b" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" Height="26" FontSize="11" Padding="6,2"
                                                          ItemsSource="{Binding AutoTuneKeyOptions}"
                                                          SelectedIndex="{Binding AutoTuneKeyIndex, Mode=TwoWay}"
                                                          ToolTip="Root key (C, C#, D...) for pitch quantization"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Scale:" FontSize="9" Foreground="#52525b" Margin="0,0,0,2"/>
                                                <ComboBox Style="{StaticResource ModernComboBox}" Height="26" FontSize="11" Padding="6,2"
                                                          ItemsSource="{Binding AutoTuneScaleOptions}"
                                                          SelectedIndex="{Binding AutoTuneScaleIndex, Mode=TwoWay}"
                                                          ToolTip="Target scale (Chromatic, Major, Minor)"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Retune Speed Slider (Hard Snap vs Natural) -->
                                        <Grid Margin="0,2,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Speed" FontSize="9" Foreground="#52525b" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Slider Grid.Column="1" Style="{StaticResource ConsoleHorizontalSlider}"
                                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding AutoTuneSpeed, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Retune Speed: 0% = Hard Snap (Cher/T-Pain robotic effect), 100% = Soft Natural"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AutoTuneSpeedText}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#a1a1aa" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Auto-Tune Mix Slider -->
                                        <Grid Margin="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Mix" FontSize="9" Foreground="#52525b" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Slider Grid.Column="1" Style="{StaticResource ConsoleHorizontalSlider}"
                                                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                                    Value="{Binding AutoTuneMix, Mode=TwoWay}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Auto-Tune dry/wet blend intensity (0% to 100%)"/>
                                            <TextBlock Grid.Column="2" Text="{Binding AutoTuneMixText}" FontFamily="Consolas" FontSize="10"
                                                       Foreground="#a1a1aa" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Mic Sync Delay (Align with YouTube playback latency) -->
                            <Border Background="#0c0c0e" BorderBrush="#1f1f23" BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Mic Sync Delay" FontSize="11" FontWeight="Medium" Foreground="#a1a1aa"/>
                                            <TextBlock Text=" (Align Tab)" FontSize="9" Foreground="#52525b" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MicDelayText}" FontFamily="Consolas" FontSize="11" 
                                                   FontWeight="SemiBold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Delay Slider (0 to 200 ms) -->
                                    <Slider Style="{StaticResource ConsoleHorizontalSlider}"
                                            Minimum="0" Maximum="200" SmallChange="1" LargeChange="10"
                                            Value="{Binding MicDelayMs, Mode=TwoWay}"
                                            Margin="0,3,0,5"
                                            ToolTip="Adjust to align microphone audio with YouTube browser playback"/>

                                    <!-- Quick Preset Badges -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Presets:" FontSize="9" Foreground="#52525b" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource ConsoleMiniBadgeButton}" Content="0ms" 
                                                Command="{Binding SetMicDelayPresetCommand}" CommandParameter="0" ToolTip="Direct mic (0 ms delay)"/>
                                        <Button Grid.Column="3" Style="{StaticResource ConsoleMiniBadgeButton}" Content="45ms" 
                                                Command="{Binding SetMicDelayPresetCommand}" CommandParameter="45" ToolTip="Standard YouTube sync (+45 ms)"/>
                                        <Button Grid.Column="5" Style="{StaticResource ConsoleMiniBadgeButton}" Content="80ms" 
                                                Command="{Binding SetMicDelayPresetCommand}" CommandParameter="80" ToolTip="High buffer sync (+80 ms)"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= 03 / MASTER OUTPUT ================= -->
                <Border Grid.Column="4" Style="{StaticResource ChannelStripStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="03" FontFamily="Consolas" FontSize="11" Foreground="#52525b" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Master Output" Style="{StaticResource TrackHeaderStyle}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="BUS MIX" FontFamily="Consolas" FontSize="10" Foreground="#52525b" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedOutput.Name, FallbackValue='No Output Device'}" 
                                       Style="{StaticResource TrackSublabelStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Output Device Selector -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      ItemsSource="{Binding RenderDevices}" 
                                      SelectedItem="{Binding SelectedOutput, Mode=TwoWay}"
                                      DisplayMemberPath="Name"/>
                        </Grid>

                        <!-- Master Fader & Meter -->
                        <Grid Grid.Row="2" Margin="0,4,0,16" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <controls:ConsoleFader Grid.Column="0" Value="{Binding MasterVolume, Mode=TwoWay}"/>

                            <controls:DualStereoLedMeter Grid.Column="2"
                                                        LevelLeft="{Binding MasterRms}" PeakLeft="{Binding MasterPeakL}" 
                                                        LevelRight="{Binding MasterRms}" PeakRight="{Binding MasterPeakR}"/>
                        </Grid>

                        <!-- Master Mute -->
                        <Grid Grid.Row="3" Margin="0,0,0,10">
                            <ToggleButton Style="{StaticResource ConsoleMuteButton}" 
                                          IsChecked="{Binding IsMasterMuted, Mode=TwoWay}"/>
                        </Grid>

                        <!-- Headphone Monitor Section -->
                        <Border Grid.Row="4" Background="#0c0c0e" BorderBrush="#1f1f23" BorderThickness="1" CornerRadius="5" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Headphone Monitor" FontSize="11" FontWeight="Medium" Foreground="#a1a1aa" VerticalAlignment="Center"/>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ConsoleCueButton}" 
                                                  IsChecked="{Binding IsMonitoringEnabled, Mode=TwoWay}"/>
                                </Grid>

                                <!-- Loopback / Monitor Source: Music (Default) | Mic | Both -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Listen To:" FontSize="9" Foreground="#52525b" VerticalAlignment="Center"/>
                                    <RadioButton Grid.Column="1" Style="{StaticResource ConsoleChipRadioButton}" Content="Music"
                                                 GroupName="MonitorSourceGroup" IsChecked="{Binding IsMonitorSourceMusic, Mode=OneWay}"
                                                 Command="{Binding SetMonitorSourceCommand}" CommandParameter="0"
                                                 ToolTip="Listen to YouTube music only (default)"/>
                                    <RadioButton Grid.Column="3" Style="{StaticResource ConsoleChipRadioButton}" Content="Mic"
                                                 GroupName="MonitorSourceGroup" IsChecked="{Binding IsMonitorSourceMic, Mode=OneWay}"
                                                 Command="{Binding SetMonitorSourceCommand}" CommandParameter="1"
                                                 ToolTip="Listen to Microphone only"/>
                                    <RadioButton Grid.Column="5" Style="{StaticResource ConsoleChipRadioButton}" Content="Both"
                                                 GroupName="MonitorSourceGroup" IsChecked="{Binding IsMonitorSourceBoth, Mode=OneWay}"
                                                 Command="{Binding SetMonitorSourceCommand}" CommandParameter="2"
                                                 ToolTip="Listen to Full Mix (Music + Mic)"/>
                                </Grid>

                                <ComboBox Style="{StaticResource ModernComboBox}" 
                                          ItemsSource="{Binding RenderDevices}" 
                                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                          DisplayMemberPath="Name" Height="28" FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

            <!-- ================= BOTTOM STATUS BAR ================= -->
            <Border Grid.Row="2" Background="#0c0c0f" BorderBrush="#1c1c20" BorderThickness="0,1,0,0" 
                    CornerRadius="0,0,7,7" Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="48.0 kHz • 32-Bit Float" FontFamily="Consolas, monospace" FontSize="11" 
                               Foreground="#52525b" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#a1a1aa" FontSize="11" 
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
