<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Monochrome Carbon / Graphite Palette -->
    <Color x:Key="ChassisBgColor">#09090b</Color>
    <Color x:Key="StripBgColor">#121215</Color>
    <Color x:Key="StripBorderColor">#222226</Color>
    <Color x:Key="RecessedTrackColor">#070709</Color>

    <SolidColorBrush x:Key="ChassisBgBrush" Color="{StaticResource ChassisBgColor}"/>
    <SolidColorBrush x:Key="StripBgBrush" Color="{StaticResource StripBgColor}"/>
    <SolidColorBrush x:Key="StripBorderBrush" Color="{StaticResource StripBorderColor}"/>
    <SolidColorBrush x:Key="RecessedTrackBrush" Color="{StaticResource RecessedTrackColor}"/>

    <!-- Minimalist Gray-Black Channel Strip -->
    <Style x:Key="ChannelStripStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StripBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource StripBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- Studio Track Header -->
    <Style x:Key="TrackHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#f4f4f5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TrackSublabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#71717a"/>
    </Style>

    <!-- Matte Graphite Studio Vertical Fader -->
    <Style x:Key="ConsoleVerticalSlider" TargetType="Slider">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid HorizontalAlignment="Center">
                        <!-- Recessed Center Groove -->
                        <Border Width="4" Background="#070709" BorderBrush="#1f1f23" BorderThickness="1" 
                                CornerRadius="2" HorizontalAlignment="Center"/>

                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- Matte Anodized Gray-Black Fader Cap -->
                                            <Border x:Name="CapBorder" Width="34" Height="22" CornerRadius="3" 
                                                    Background="#202024" BorderBrush="#3f3f46" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Height="1" Background="#141417" Margin="5,4,5,0" VerticalAlignment="Top"/>
                                                    <!-- Crisp White Unity Line -->
                                                    <Border Grid.Row="1" Height="1.5" Background="#f4f4f5" Margin="4,0"/>
                                                    <Border Grid.Row="2" Height="1" Background="#141417" Margin="5,0,5,4" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CapBorder" Property="Background" Value="#27272c"/>
                                                    <Setter TargetName="CapBorder" Property="BorderBrush" Value="#52525b"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="CapBorder" Property="Background" Value="#2e2e34"/>
                                                    <Setter TargetName="CapBorder" Property="BorderBrush" Value="#a1a1aa"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Matte Graphite Studio Horizontal Slider -->
    <Style x:Key="ConsoleHorizontalSlider" TargetType="Slider">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- Recessed Track Groove -->
                        <Border Height="4" Background="#070709" BorderBrush="#1f1f23" BorderThickness="1" 
                                CornerRadius="2" VerticalAlignment="Center"/>

                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- Minimalist Pill Thumb -->
                                            <Border x:Name="ThumbBorder" Width="14" Height="14" CornerRadius="7" 
                                                    Background="#27272a" BorderBrush="#52525b" BorderThickness="1.5">
                                                <Ellipse Width="4" Height="4" Fill="#f4f4f5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#3f3f46"/>
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#a1a1aa"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#52525b"/>
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#f4f4f5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimalist Console Mini Badge Button -->
    <Style x:Key="ConsoleMiniBadgeButton" TargetType="Button">
        <Setter Property="Background" Value="#18181b"/>
        <Setter Property="Foreground" Value="#a1a1aa"/>
        <Setter Property="BorderBrush" Value="#27272a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BadgeBorder" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#27272a"/>
                            <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#3f3f46"/>
                            <Setter Property="Foreground" Value="#f4f4f5"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#3f3f46"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sleek Monochrome Chip RadioButton for Mode/Source Selection -->
    <Style x:Key="ConsoleChipRadioButton" TargetType="RadioButton">
        <Setter Property="Background" Value="#141417"/>
        <Setter Property="Foreground" Value="#71717a"/>
        <Setter Property="BorderBrush" Value="#222226"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1c1c20"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#3f3f46"/>
                            <Setter Property="Foreground" Value="#d4d4d8"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#27272c"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#71717a"/>
                            <Setter Property="Foreground" Value="#f4f4f5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimalist Mute Button -->
    <Style x:Key="ConsoleMuteButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="#18181b"/>
        <Setter Property="Foreground" Value="#a1a1aa"/>
        <Setter Property="BorderBrush" Value="#27272a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="LedDot" Width="5" Height="5" Fill="#52525b" Margin="0,0,7,0"/>
                            <TextBlock x:Name="LabelTxt" Text="MUTE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#3f3f46"/>
                            <Setter Property="Foreground" Value="#f4f4f5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#7f1d1d"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#b91c1c"/>
                            <Setter TargetName="LedDot" Property="Fill" Value="#f87171"/>
                            <Setter Property="Foreground" Value="#fef2f2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimalist Monitor / Listen Button -->
    <Style x:Key="ConsoleCueButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="#18181b"/>
        <Setter Property="Foreground" Value="#a1a1aa"/>
        <Setter Property="BorderBrush" Value="#27272a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" Padding="10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="LedDot" Width="5" Height="5" Fill="#52525b" Margin="0,0,6,0"/>
                            <TextBlock x:Name="Txt" Text="OFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#3f3f46"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#f4f4f5"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#f4f4f5"/>
                            <Setter TargetName="LedDot" Property="Fill" Value="#09090b"/>
                            <Setter TargetName="Txt" Property="Text" Value="ON"/>
                            <Setter Property="Foreground" Value="#09090b"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Gray-Black ComboBox Item -->
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#d4d4d8"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#222226"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#27272c"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Gray-Black ComboBox -->
    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="#0c0c0e"/>
        <Setter Property="Foreground" Value="#e4e4e7"/>
        <Setter Property="BorderBrush" Value="#242428"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Name="ToggleButton" 
                                      Background="{TemplateBinding Background}" 
                                      BorderBrush="{TemplateBinding BorderBrush}" 
                                      BorderThickness="{TemplateBinding BorderThickness}" 
                                      Focusable="false" 
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border" CornerRadius="4" Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="26"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#71717a" Data="M 0 0 L 3.5 3.5 L 7 0 Z"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Border" Property="BorderBrush" Value="#3f3f46"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder" Background="#141417" BorderThickness="1" BorderBrush="#27272c" CornerRadius="5" Margin="0,2,0,0">
                                    <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Gray-Black Buttons -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="#18181b"/>
        <Setter Property="Foreground" Value="#d4d4d8"/>
        <Setter Property="BorderBrush" Value="#27272a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#222226"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="#3f3f46"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#27272c"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-Contrast Monochrome Primary Button -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="#f4f4f5"/>
        <Setter Property="Foreground" Value="#09090b"/>
        <Setter Property="BorderBrush" Value="#f4f4f5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#e4e4e7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#71717a"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#1f1f23"/>
                            <Setter Property="Foreground" Value="#f4f4f5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#dc2626"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
