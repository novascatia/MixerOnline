<Window x:Class="MixerOnline.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="470" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#0c0c0f" BorderBrush="#242429" BorderThickness="1" CornerRadius="8">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" Background="#f4f4f5" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="OnCloseClicked">
                    <TextBlock Text="✕" FontSize="11"/>
                </Button>
            </Grid>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Audio Latency / Buffer -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Audio Buffer Size" FontSize="12" FontWeight="SemiBold" Foreground="#e4e4e7" Margin="0,0,0,4"/>
                            <TextBlock Text="Balances latency vs stability for WASAPI output." FontSize="11" Foreground="#71717a" Margin="0,0,0,10"/>
                            <ComboBox x:Name="ComboLatency" Style="{StaticResource ModernComboBox}" SelectedIndex="1">
                                <ComboBoxItem Content="15 ms — Ultra Low Latency (Requires fast CPU)"/>
                                <ComboBoxItem Content="30 ms — Low Latency (Recommended for Streaming)"/>
                                <ComboBoxItem Content="50 ms — Standard Latency"/>
                                <ComboBoxItem Content="100 ms — Safe Buffer (Highest Stability)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Mixing Bus Format -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Audio Engine Format" FontSize="12" FontWeight="SemiBold" Foreground="#e4e4e7"/>
                                <TextBlock Text="Uncompressed bit-transparent stereo bus" FontSize="11" Foreground="#71717a" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#18181b" BorderBrush="#27272c" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="48.0 kHz • 32-Bit" FontFamily="Consolas" Foreground="#d4d4d8" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- App Behavior -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Application" FontSize="12" FontWeight="SemiBold" Foreground="#e4e4e7" Margin="0,0,0,10"/>
                            
                            <CheckBox x:Name="CheckMinimizeToTray" Content="Minimize to system tray when closed" 
                                      Foreground="#a1a1aa" FontSize="11" Margin="0,0,0,8" IsChecked="True"/>

                            <CheckBox x:Name="CheckAutoReconnect" Content="Automatically reconnect audio devices" 
                                      Foreground="#a1a1aa" FontSize="11" Margin="0,0,0,8" IsChecked="True"/>

                            <CheckBox x:Name="CheckHearTabInBrowser" Content="Play captured tab audio in browser when Monitor is OFF" 
                                      Foreground="#a1a1aa" FontSize="11" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Network Bridge Configuration -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Local Bridge Port" FontSize="12" FontWeight="SemiBold" Foreground="#e4e4e7"/>
                                <TextBlock Text="Loopback WebSocket endpoint" FontSize="11" Foreground="#71717a" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="TxtPort" Grid.Column="1" Text="49876" Width="72" Height="28" 
                                     Background="#09090b" Foreground="#f4f4f5" BorderBrush="#27272c" FontFamily="Consolas"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="11"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource ModernButton}" Content="Cancel" Width="86" Click="OnCloseClicked" HorizontalAlignment="Left"/>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="Save Changes" Width="116" Click="OnSaveClicked"/>
            </Grid>

        </Grid>
    </Border>
</Window>
