<Window x:Class="MixerOnline.Views.SetupGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup Guide" 
        Height="560" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#0c0c0f" BorderBrush="#242429" BorderThickness="1" CornerRadius="8">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" Background="#f4f4f5" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Quick Setup Guide" FontSize="15" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}" Click="OnCloseClicked">
                    <TextBlock Text="✕" FontSize="11"/>
                </Button>
            </Grid>

            <!-- Guide Steps -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Step 1: Browser Extension -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="01" FontFamily="Consolas" FontSize="11" Foreground="#71717a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Load Browser Audio Extension" FontSize="12" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Captures uncompressed 48kHz stereo audio exclusively from a chosen tab in Chrome, Brave, Edge, Opera, or Vivaldi." 
                                       FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Open Browser Extensions" Margin="0,0,8,0" Padding="12,6" Click="OnOpenBrowserExtensionsClicked"/>
                                <Button Style="{StaticResource ModernButton}" Content="Open Extension Folder" Padding="12,6" Click="OnOpenFolderClicked"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtExtensionInstruction"
                                       Text="1. Open your browser's Extensions page (chrome://extensions, brave://extensions, or edge://extensions). 2. Enable Developer mode. 3. Click 'Load unpacked' and select the 'extension' folder." 
                                       FontSize="11" Foreground="#71717a" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Virtual Audio Cable -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" FontFamily="Consolas" FontSize="11" Foreground="#71717a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="VB-Audio Virtual Cable" FontSize="12" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="VbStatusBadge" Grid.Column="1" Background="#18181b" BorderBrush="#27272c" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                    <TextBlock x:Name="VbStatusText" Text="Installed" Foreground="#e4e4e7" FontSize="10" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="MixerOnline routes the combined mix into 'CABLE Input'. Select 'CABLE Output' as your microphone in other apps." 
                                       FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Button x:Name="BtnDownloadVb" Style="{StaticResource ModernButton}" Content="Download VB-Cable Driver" 
                                     HorizontalAlignment="Left" Padding="12,6" Click="OnDownloadVbClicked" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Discord / OBS / Zoom Setup -->
                    <Border Background="#121215" BorderBrush="#222226" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="03" FontFamily="Consolas" FontSize="11" Foreground="#71717a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Discord / OBS / TikTok Live Studio" FontSize="12" FontWeight="SemiBold" Foreground="#f4f4f5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="• Microphone / Input Device: Select 'CABLE Output (VB-Audio Virtual Cable)'." FontSize="11" Foreground="#a1a1aa" Margin="0,0,0,3"/>
                            <TextBlock Text="• Keep 'Headphone Monitor' OFF during normal streaming so you hear tab audio directly in your browser with 0ms delay and no microphone echo." FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Close Button -->
            <Button Grid.Row="2" Style="{StaticResource AccentButton}" Content="Done" HorizontalAlignment="Right" Width="100" Margin="0,16,0,0" Click="OnCloseClicked"/>

        </Grid>
    </Border>
</Window>
